  ACTIVITY {
    uuid id PK
    string kind "TASK, WORKSHOP, EXAM"
    string status "DRAFT, PUBLISHED"
    timestamptz opens_at
    timestamptz closes_at
    int max_attempts "1 a 10"
    numeric weight_percent "opcional"
  }
  SUBMISSION {
    uuid id PK
    uuid activity_id FK
    uuid student_id FK
    int attempt "UK con actividad y estudiante"
    text text_answer
    bool late
  }
  GRADE {
    uuid id PK
    uuid submission_id FK "UK"
