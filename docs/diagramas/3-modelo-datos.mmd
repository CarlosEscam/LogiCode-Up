    string status "PROCESSING, PENDING_REVIEW, PUBLISHED"
    numeric score "0,0 a 5,0"
    string source "TEACHER, AI, AUTOMATIC"
    string review_reason
  }
  AI_GRADING_JOB {
    uuid id PK
    uuid grade_id FK
    string status "PENDING, RUNNING, DONE, FAILED"
    int attempts
    uuid claim_token
  }
  AI_EVALUATION {
    uuid id PK
    uuid grade_id FK
    string outcome "PUBLISHED, ILLEGIBLE, LOW_CONFIDENCE, FAILED"
    int confidence "0 a 100"
    numeric proposed_score
