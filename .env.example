# LogiCode · variables de entorno de ejemplo para desarrollo local.
# Copia este archivo como .env y cambia los valores. El archivo .env nunca se sube al repositorio.

# --- Base de datos (PostgreSQL) ---
DB_NAME=logicode
DB_USERNAME=logicode
# Elige una contraseña propia para tu base de datos local.
DB_PASSWORD=cambia-esta-clave-local
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8080
LOGICODE_TIME_ZONE=America/Bogota

# --- Frontend ---
FRONTEND_PORT=3000

# --- Cuentas iniciales con privilegio completo (se usan desde la Etapa 3) ---
# Completa estos datos solo en tu .env. Nunca los escribas en el código ni en este archivo.
INITIAL_ADMIN_1_CEDULA=
INITIAL_ADMIN_1_NAME=
INITIAL_ADMIN_1_EMAIL=
INITIAL_ADMIN_2_CEDULA=
INITIAL_ADMIN_2_NAME=
INITIAL_ADMIN_2_EMAIL=

# --- Sesión y correo ---
# Dirección con la que abres la interfaz; se usa en los enlaces de verificación y recuperación.
LOGICODE_PUBLIC_URL=http://localhost:3000
# Duración de la sesión sin actividad.
SESSION_TIMEOUT=2h
# true solo cuando la plataforma se sirva por HTTPS.
SESSION_COOKIE_SECURE=false
# outbox: guarda los correos como archivos .html en .local/mail-outbox (desarrollo).
# Para enviar con Brevo usa docker-compose.brevo.yml; la API key y el remitente van en
# secrets/brevo_api_key.txt y secrets/brevo_sender_email.txt, nunca en este archivo.
LOGICODE_MAIL_PROVIDER=outbox
BREVO_SENDER_NAME=LogiCode

# --- Archivos ---
# Meses que se conserva un archivo cargado antes de poder borrarse (mínimo 6, RN-21).
LOGICODE_FILE_RETENTION_MONTHS=6

# --- Respaldos (Etapa 8) ---
# Hora (0 a 23, hora de Colombia) de la copia diaria de la base y los archivos, y días que se conservan las copias.
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30

# --- Calificación con IA (Etapa 6) ---
# true para calificar con Ollama + Qwen2.5-VL 7B; requiere `docker compose --profile ia up --build`
# y descargar el modelo una vez (ver README). Con false, todas las entregas pasan a Por revisar.
LOGICODE_AI_ENABLED=false
LOGICODE_AI_MODEL=qwen2.5vl:7b
# Tiempo máximo por evaluación; en CPU una foto puede tardar varios minutos.
LOGICODE_AI_TIMEOUT=10m
# Intentos ante fallos técnicos antes de pasar la entrega al docente.
LOGICODE_AI_MAX_ATTEMPTS=3
