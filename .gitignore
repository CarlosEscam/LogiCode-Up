# Secretos y configuración local
.env
.env.*
!.env.example
secrets/
# Correos guardados en desarrollo (contienen enlaces de un solo uso)
.local/

# Backend (Maven)
backend/target/

# Frontend (Node)
frontend/node_modules/
frontend/dist/
frontend/coverage/

# IDE y sistema
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

